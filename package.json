{
  "name": "palari-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Chat memory with a canonical dialogue journal, bounded per-interaction reduction, host-verified provenance, and exact-ID forgetting.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./gemini": "./src/gemini.mjs",
    "./openai": "./src/openai.mjs"
  },
  "files": [
    "src/brain.mjs",
    "src/dialogue-evidence.mjs",
    "src/gemini.mjs",
    "src/index.mjs",
    "src/longmemeval.mjs",
    "src/memory-digest-store.mjs",
    "src/memory-exploration.mjs",
    "src/memory-forget.mjs",
    "src/memory-graph.mjs",
    "src/memory-search.mjs",
    "src/memory-semantic.mjs",
    "src/memory-trend.mjs",
    "src/memory-reducer.mjs",
    "src/memory-store.mjs",
    "src/openai.mjs",
    "src/quote-context.mjs",
    "src/retrieval-answer.mjs",
    "src/statement-extraction.mjs",
    "src/store.mjs",
    "src/util.mjs",
    "examples",
    "docs/BRAIN-API.md",
    "docs/CONSUMER-SEAM.md",
    "docs/KERNEL-API.md",
    "docs/KERNEL-CONTRACT.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test",
    "quickstart": "node examples/quickstart.mjs",
    "bakeoff": "node evals/run-bakeoff.mjs",
    "memory-bench": "node evals/run-offline-memory-bench.mjs",
    "probe": "node evals/run-dev-provider-probe.mjs",
    "answer-interpretation-regression": "node evals/run-answer-interpretation-regression.mjs",
    "reached-prefix-regression": "node evals/run-reached-prefix-retrieval-regression.mjs",
    "trust-bench": "node evals/run-trust-benchmark.mjs",
    "scale-probe": "node evals/run-scale-probe.mjs",
    "ticket": "node scripts/ticket-system.mjs"
  },
  "devDependencies": {
    "@google/genai": "1.40.0",
    "mem0ai": "3.1.1"
  }
}
